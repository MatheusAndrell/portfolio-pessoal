---
import '@fontsource-variable/inter';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { identity, ui, t, LANGS, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = t(ui.meta.title, lang);
const description = t(ui.meta.description, lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(`/${lang}/`, site).href;
const ogImage = new URL('/og-image.png', site).href;
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: 'Backend Software Engineer',
  email: `mailto:${identity.contact.email}`,
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  sameAs: [identity.contact.linkedin, identity.contact.github],
  knowsAbout: ['Java', 'Spring Boot', 'Node.js', 'TypeScript', 'AWS', 'Event-Driven Architecture', 'RAG', 'MCP'],
};
---

<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l === 'pt' ? 'pt-BR' : 'en'} href={new URL(`/${l}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/pt/', site).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#07060B" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F4FA" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${identity.name} — ${t(identity.tagline, lang)}`} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta property="profile:first_name" content={identity.firstName} />
    <meta property="profile:last_name" content={identity.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Tema antes da primeira pintura: escuro por padrão, claro se o visitante escolheu. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (e) {}
        d.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(ui.skip, lang)}</a>
    <div class="glows" aria-hidden="true"><span></span><span></span><span></span></div>
    <slot />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
