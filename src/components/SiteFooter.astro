---
import { identity, ui, t, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer container">
  <div class="foot">
    <a class="brand display" href="#main">
      <span class="brand__dot" aria-hidden="true"></span>
      ANDRELL
    </a>
    <p class="mono">{t(identity.location, lang)} · {t(identity.workModes, lang).toLowerCase()}</p>
    <p class="mono">© {year} {identity.name} · {t(ui.footer.built, lang)}</p>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 28px 36px;
    border-top: 1px solid var(--line);
  }
  .foot p {
    font-size: 12px;
    color: var(--subtle);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .brand__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--grad);
  }
</style>
