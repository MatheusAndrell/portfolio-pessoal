---
import { identity, ui, t, type Lang } from '../data/profile';
import LiquidBlob from './LiquidBlob.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tagline = t(identity.tagline, lang);
const accent = t(identity.taglineAccent, lang);
const [before, after] = tagline.split(accent);
const stackLine = identity.headline.split('|').map((s) => s.trim());
const resume = identity.resumes.find((r) => r.lang === lang) ?? identity.resumes[0];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="kicker hero__in" style="--d: 0ms">{t(identity.role, lang)} · {t(identity.location, lang)}</p>
    <h1 id="hero-title" class="hero__name display">
      <span class="hero__line"><span class="hero__in" style="--d: 80ms">{identity.firstName}</span></span>
      <span class="hero__line"><span class="hero__in" style="--d: 180ms">{identity.lastName}</span></span>
    </h1>
    <p class="hero__tagline hero__in" style="--d: 320ms">
      {before}<span class="grad-text">{accent}</span>{after}
    </p>
    <ul class="hero__stack mono hero__in" style="--d: 420ms">
      {stackLine.map((s) => <li>{s}</li>)}
    </ul>
    <div class="hero__actions hero__in" style="--d: 520ms">
      <a class="btn btn--orb" href="#pipeline">
        {t(ui.hero.cta, lang)}
        <span class="btn__orb" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </span>
      </a>
      <a class="btn hero__cv" href={resume.href} download hreflang={resume.lang === 'pt' ? 'pt-BR' : 'en'} type="application/pdf">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
        {t(ui.hero.resume, lang)}
      </a>
      <a class="icon-btn" href={identity.contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path></svg>
      </a>
      <a class="icon-btn" href={identity.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
      </a>
    </div>
  </div>

  <div class="hero__art">
    <LiquidBlob id="hero" />
    <p class="hero__event mono" data-hero-event aria-hidden="true">
      <span class="hero__event-dot"></span>
      <span data-hero-event-type>evt_0193f…a1 · order.created v1</span>
      <span class="hero__event-sub" data-hero-event-status>webhook · 200 OK · 41 ms</span>
    </p>
  </div>

  <div class="hero__foot">
    <span class="kicker">{t(identity.workModes, lang)}</span>
    <a class="icon-btn hero__down" href="#pipeline" aria-label={t(ui.nav.pipeline, lang)}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
    </a>
    <span class="kicker hero__since">2023 → {lang === 'pt' ? 'hoje' : 'today'}</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding-top: clamp(40px, 7vw, 88px);
  }
  .hero__name {
    margin-top: 20px;
    font-size: clamp(44px, 6.4vw, 96px);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .hero__line {
    display: block;
    overflow-x: visible;
    overflow-y: clip;
    padding-bottom: 0.04em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__tagline {
    margin-top: 26px;
    max-width: 22ch;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.35;
    color: var(--text-2);
  }
  .hero__tagline .grad-text {
    font-weight: 700;
  }
  .hero__stack {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    color: var(--subtle);
  }
  .hero__actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .hero__cv {
    min-height: 52px;
    gap: 10px;
  }
  .hero__cv svg {
    transition: transform 0.35s var(--ease-out);
  }
  .hero__cv:hover svg {
    transform: translateY(2px);
  }
  .hero__art {
    position: relative;
    aspect-ratio: 1;
    max-height: 600px;
    width: 100%;
  }
  .hero__event {
    position: absolute;
    right: 4%;
    bottom: 8%;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 8px;
    padding: 12px 16px;
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-2);
    transition: transform 0.4s var(--ease-out);
  }
  .hero__event.is-bump {
    animation: bump 0.6s var(--ease-out);
  }
  .hero__event-dot {
    align-self: center;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffa24d;
    box-shadow: 0 0 10px #ffa24d;
  }
  .hero__event-sub {
    grid-column: 2;
    color: var(--subtle);
  }
  .hero__foot {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px 8px;
  }
  .hero__down {
    width: 64px;
    height: 64px;
  }
  .hero__down svg {
    animation: nudge 2.4s var(--ease-out) infinite;
  }

  /* entrada do hero, uma única vez */
  .hero__in {
    animation: rise 1s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }
  .hero__line > .hero__in {
    animation-name: rise-line;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes rise-line {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  @keyframes nudge {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(5px); }
  }
  @keyframes bump {
    0% { transform: scale(1); }
    40% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__art {
      order: -1;
      max-width: 420px;
      margin: 0 auto -40px;
    }
    .hero__since {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .hero__event {
      right: 0;
      bottom: 14%;
    }
  }
</style>
