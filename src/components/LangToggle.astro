---
import { LANGS, ui, t, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<nav class="lang" aria-label={t(ui.lang.label, lang)}>
  {
    LANGS.map((l) => (
      <a
        href={`/${l}/`}
        hreflang={l === 'pt' ? 'pt-BR' : 'en'}
        lang={l === 'pt' ? 'pt-BR' : 'en'}
        aria-current={l === lang ? 'page' : undefined}
        data-lang-link
      >
        <span aria-hidden="true">{l.toUpperCase()}</span>
        <span class="sr-only">{l === 'pt' ? 'Português' : 'English'}</span>
      </a>
    ))
  }
</nav>

<script>
  /**
   * Ao trocar de idioma, mantém o visitante no mesmo ponto da página.
   * Guarda a seção visível + o deslocamento dentro dela (não usa o #hash,
   * que pode estar desatualizado depois de rolar).
   */
  const KEY = 'lang-switch-scroll';

  function currentAnchor() {
    const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
    const y = window.scrollY;
    let anchor: HTMLElement | null = null;
    for (const s of sections) {
      if (s.offsetTop <= y + 1) anchor = s;
    }
    return anchor ? { id: anchor.id, offset: y - anchor.offsetTop } : { id: '', offset: y };
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
    a.addEventListener('click', () => {
      a.href = a.pathname; // sem hash
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ ...currentAnchor(), t: Date.now() }));
      } catch {
        /* sem armazenamento: abre no topo */
      }
    });
  });

  // Na página nova, restaura a posição.
  try {
    const raw = sessionStorage.getItem(KEY);
    sessionStorage.removeItem(KEY);
    const saved = raw ? (JSON.parse(raw) as { id: string; offset: number; t: number }) : null;
    if (saved && Date.now() - saved.t < 15000) {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const restore = () => {
        const el = saved.id ? document.getElementById(saved.id) : null;
        const top = (el ? el.offsetTop : 0) + saved.offset;
        window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
      };
      restore();
      // O layout ainda cresce logo após o carregamento (fontes, painéis, simulação).
      // Reaplica a posição a cada mudança de altura por até 2 s, ou até o visitante rolar.
      const ro = new ResizeObserver(restore);
      ro.observe(document.body);
      const stop = () => {
        ro.disconnect();
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) => removeEventListener(ev, stop));
      };
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) => addEventListener(ev, stop, { passive: true }));
      document.fonts?.ready.then(restore);
      setTimeout(stop, 2000);
    }
  } catch {
    /* ignora */
  }
</script>

<style>
  .lang {
    display: flex;
    padding: 3px;
    border-radius: var(--pill);
    border: 1px solid var(--line-strong);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 42px;
    min-height: 38px;
    border-radius: var(--pill);
    font-family: var(--font-mono);
    font-size: 12px;
    text-decoration: none;
    color: var(--muted);
    transition: background-color 0.25s, color 0.25s;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a[aria-current='page'] {
    background: var(--glass-strong);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
