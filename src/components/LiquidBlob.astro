---
/**
 * Forma "líquida" em SVG: camadas com degradê, sombra interna e brilho.
 * Animação só com transform (barata) e desligada em prefers-reduced-motion.
 */
interface Props {
  id: string;
  variant?: 'hero' | 'contact';
  class?: string;
}
const { id, variant = 'hero', class: className } = Astro.props;
const g = (n: string) => `${id}-${n}`;
---

<svg class:list={['blob', `blob--${variant}`, className]} viewBox="0 0 600 600" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={g('a')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5B2BE0"></stop>
      <stop offset="0.45" stop-color="#FF3D7F"></stop>
      <stop offset="0.8" stop-color="#F28C28"></stop>
      <stop offset="1" stop-color="#FFD9B0"></stop>
    </linearGradient>
    <linearGradient id={g('b')} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A77BFF"></stop>
      <stop offset="0.6" stop-color="#7B3FF2"></stop>
      <stop offset="1" stop-color="#2A1260"></stop>
    </linearGradient>
    <radialGradient id={g('hl')} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <filter id={g('b4')} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4"></feGaussianBlur></filter>
    <filter id={g('b14')} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="14"></feGaussianBlur></filter>
    <filter id={g('b60')} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="60"></feGaussianBlur></filter>
  </defs>

  <ellipse class="blob__halo" cx="320" cy="300" rx="230" ry="210" fill="#FF3D7F" filter={`url(#${g('b60')})`}></ellipse>

  <g class="blob__body">
    <path class="blob__back" d="M120 250 C 150 110, 330 40, 460 110 C 590 180, 560 330, 480 420 C 400 510, 250 560, 160 480 C 80 410, 95 330, 120 250 Z" fill={`url(#${g('b')})`}></path>
    <g class="blob__front">
      <path d="M170 230 C 220 120, 380 90, 470 170 C 540 235, 520 330, 440 380 C 380 420, 330 380, 280 420 C 220 470, 140 430, 140 360 C 140 310, 150 270, 170 230 Z" fill={`url(#${g('a')})`}></path>
      <path class="blob__shade" d="M230 260 C 270 190, 370 180, 410 230 C 440 270, 410 320, 360 320 C 320 320, 300 350, 260 340 C 220 330, 210 295, 230 260 Z" filter={`url(#${g('b14')})`}></path>
      <path d="M170 230 C 220 120, 380 90, 470 170" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity="0.7" filter={`url(#${g('b4')})`}></path>
      <path d="M440 380 C 380 420, 330 380, 280 420" fill="none" stroke="#FFE2C4" stroke-width="4" stroke-linecap="round" opacity="0.8" filter={`url(#${g('b4')})`}></path>
      <ellipse class="blob__shine" cx="250" cy="200" rx="70" ry="34" fill={`url(#${g('hl')})`} transform="rotate(-28 250 200)" filter={`url(#${g('b4')})`}></ellipse>
    </g>
  </g>

  {
    variant === 'hero' && (
      <g class="blob__lines" fill="none" stroke={`url(#${g('a')})`} stroke-width="1.2">
        <path d="M40 470 C 160 380, 260 520, 380 430 S 560 360, 600 300" />
        <path d="M40 490 C 170 400, 270 540, 390 450 S 570 380, 610 320" />
        <path d="M40 510 C 180 420, 280 560, 400 470 S 580 400, 620 340" />
      </g>
    )
  }
</svg>

<style>
  .blob {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .blob--contact {
    transform: rotate(180deg) scaleX(-1);
  }
  .blob__halo {
    opacity: 0.35;
    transform-origin: 320px 300px;
    animation: halo 9s ease-in-out infinite alternate;
  }
  .blob__body {
    transform-origin: 300px 300px;
    animation: float 12s ease-in-out infinite alternate;
  }
  .blob__back {
    transform-origin: 340px 300px;
    animation: wobble 16s ease-in-out infinite alternate;
  }
  .blob__front {
    transform-origin: 320px 280px;
    animation: wobble-2 11s ease-in-out infinite alternate;
  }
  .blob__shade {
    fill: var(--blob-shade);
    opacity: 0.7;
  }
  .blob__shine {
    opacity: 0.7;
    animation: shine 7s ease-in-out infinite alternate;
  }
  .blob__lines {
    opacity: 0.55;
    stroke-dasharray: 6 10;
    animation: flow 6s linear infinite;
  }

  @keyframes float {
    from { transform: translate3d(0, -10px, 0) rotate(-3deg); }
    to { transform: translate3d(0, 14px, 0) rotate(4deg); }
  }
  @keyframes wobble {
    from { transform: rotate(-6deg) scale(1); }
    to { transform: rotate(8deg) scale(1.04, 0.97); }
  }
  @keyframes wobble-2 {
    from { transform: rotate(4deg) scale(0.98, 1.02); }
    to { transform: rotate(-7deg) scale(1.04, 0.97); }
  }
  @keyframes halo {
    from { transform: scale(0.92); opacity: 0.28; }
    to { transform: scale(1.08); opacity: 0.42; }
  }
  @keyframes shine {
    from { opacity: 0.45; }
    to { opacity: 0.85; }
  }
  @keyframes flow {
    to { stroke-dashoffset: -160; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob *,
    .blob {
      animation: none !important;
    }
  }
</style>
